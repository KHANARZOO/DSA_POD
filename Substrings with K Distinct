class Solution {
    public int countSubstr(String s, int k) {
       int n = s.length();
       //Brute Force Approach
       HashSet<Character> set = new HashSet<>();
       int count = 0;
       
       for(int i=0; i<n; i++){
           for(int j=i; j<n; j++){
               set.add(s.charAt(j));
               if(set.size() == k){
                   count+=1;
               }
           }
           set.clear();
       }
       return count;
    }
}
