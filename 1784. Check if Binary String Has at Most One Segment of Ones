class Solution {
    public boolean checkOnesSegment(String s) {
        int n = s.length();
        Stack<Character> st = new Stack<>();
        st.add(s.charAt(0));
        for (int i = 1; i < n; i++) {
            char ch = s.charAt(i);
            if (st.peek() - '0' == 1 && ch - '0' == 0)
                st.add(ch);
            else if (st.peek() - '0' == 0 && ch - '0' == 1)
                return false;
        }
        return true;
    }
}
