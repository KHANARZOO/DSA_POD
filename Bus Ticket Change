class Solution {
    public boolean canServe(int[] arr) {
        int n = arr.length;
        int count5 = 0;
        int count10 = 0;
        
        for(int i=0; i<n; i++){
            if(arr[i] == 5) count5 += 1;
            else if(arr[i] == 10){
                if(count5 > 0){
                    count5-=1;
                    count10+=1;
                }else return false;
            }else{
                //20
                if(count10 > 0 && count5 > 0){
                    count10-=1;
                    count5-=1;
                }else if(count5 >=3) count5-=3;
                else return false;
            }
        }
        return true;
    }
}
