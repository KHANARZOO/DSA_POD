class Solution {
    int count;
    public int countSubset(int[] arr, int k) {
        int n = arr.length;
        count = 0;
        solve(0, 0, arr, n, k);
        return count;
    }
    private void solve(int idx, int currSum, int[]arr, int n, int k){
        if(idx == n){
            if(currSum == k) count+=1;
            return;
        }
        if(currSum > k) return;
        currSum += arr[idx];
        solve(idx + 1, currSum, arr, n, k);
        currSum -= arr[idx];
        solve(idx + 1, currSum, arr, n, k);
    }
}
