class Solution {
    int[] dx = {0, 0, -1, 1};
    int[] dy = {-1, 1, 0, 0};
    public boolean isWordExist(char[][] mat, String word) {
       int n = mat.length;
       int m = mat[0].length;
       
       for(int i=0; i<n; i++){
           for(int j=0; j<m; j++){
               if(mat[i][j] == word.charAt(0) && find(i, j, 0, mat, word, n, m)){
                  return true;
               } 
           }
       }
       return false;
    }
    private boolean find(int i, int j, int idx, char[][] mat, String word, int n, int m){
        if(idx == word.length()) return true;
        if(i < 0 || j < 0 || i >= n || j >= m || mat[i][j] != word.charAt(idx)) return false;
        char ch = mat[i][j];
        mat[i][j] = '$';
        for(int l=0; l<4; l++){
            int ni = i + dx[l];
            int nj = j + dy[l];
            
            if(find(ni, nj, idx + 1, mat, word, n, m)){
                return true;
            }
        }
        mat[i][j] = ch;
        return false;
    }
}
