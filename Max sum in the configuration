class Solution {
    int maxSum(int[] arr) {
        int n = arr.length;
        int currSum = 0;
        int maxSum = 0;
        int totalSum = 0;
        
        for(int i = 0; i<n; i++){
            currSum += arr[i] * i;
            totalSum += arr[i];
        }
        maxSum = currSum;
        for(int i = 1; i<n; i++){
            currSum = currSum + totalSum - (n * arr[n - i]);
            maxSum = Math.max(maxSum, currSum);
        }
        return maxSum;
    }
}
