class Solution {
    boolean pythagoreanTriplet(int[] arr) {
        int n = arr.length;
        Set<Integer> set = new HashSet<>();
        
        for(int i=0; i<n; i++)
            set.add(arr[i] * arr[i]);
            
        for(int i=0; i<n - 1; i++){
            int a = arr[i] * arr[i];
            for(int j = i + 1; j<n; j++){
                int b = arr[j] * arr[j];
                if(set.contains(a + b))
                    return true;
            }
        }
        return false;
    }
}
