class Solution {
    public String addBinary(String a, String b) {
        int n = a.length();
        int m = b.length();
        int len = Math.max(n, m);
        int carry = 0;
        int sum = 0;
        int res = 0;
        StringBuilder sb = new StringBuilder();

        int i = n-1;
        int j = m-1;

        while(i >= 0 && j >= 0){
            int n1 = a.charAt(i) - '0';
            int n2 = b.charAt(j) - '0';

            sum = n1 + n2 + carry;
            res = sum % 2; //2%2 = 0
            carry = sum / 2; //2/2 = 1

            sb.append(res);

            i--;
            j--;
        }
        while(i >= 0){
            int n1 = a.charAt(i) - '0';
            sum = n1 + carry;
            res = sum % 2; //2%2 = 0
            carry = sum / 2; // 2/2 = 1
            sb.append(res);
            i--;
        }
        while(j >= 0){
            int n2 = b.charAt(j) - '0';
            sum = n2 + carry;
            res = sum % 2;
            carry = sum / 2;
            sb.append(res);
            j--;
        }

        if(carry!=0){
            sb.append(carry); // 001
        }
        sb.reverse(); // 100
        return sb.toString();
    }
}
