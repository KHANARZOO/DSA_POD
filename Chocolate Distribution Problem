class Solution {
    public int findMinDiff(ArrayList<Integer> arr, int m) {
        int n = arr.size();
        Collections.sort(arr);
        int j = m -1;
        int i = 0;
        int minDiff = Integer.MAX_VALUE;
        
        while(j < n){
            int diff = arr.get(j) - arr.get(i);
            minDiff = Math.min(minDiff, diff);
            i+=1;
            j+=1;
        }
        return minDiff;
    }
}
