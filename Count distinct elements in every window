class Solution {
    ArrayList<Integer> countDistinct(int arr[], int k) {
        int n = arr.length;
        ArrayList<Integer> li = new ArrayList<>();
        HashMap<Integer, Integer> map = new HashMap<>();
        for(int i=0; i<k; i++) map.put(arr[i], map.getOrDefault(arr[i], 0)+ 1);
        li.add(map.size());
        int si = 1;
        int ed = k;
        
        while(ed < n){
            map.put(arr[si - 1], map.getOrDefault(arr[si - 1], 0)- 1);
            if(map.get(arr[si - 1]) == 0) map.remove(arr[si - 1]);
            map.put(arr[ed], map.getOrDefault(arr[ed], 0) + 1);
            li.add(map.size());
            si+=1;
            ed+=1;
        }
        return li;
    }
}
