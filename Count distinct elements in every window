class Solution {
    ArrayList<Integer> countDistinct(int arr[], int k) {
        int n = arr.length;
        //Brute Force Approach
        ArrayList<Integer> li = new ArrayList<>();
        HashSet<Integer> set = new HashSet<>();
        int count = 0;
        for(int i=0; i<n; i++){
            count = 0;
            for(int j=i; j<n; j++){
                set.add(arr[j]);
                if((j - i + 1) == k){
                    li.add(set.size());
                    break;
                }
            }
            set.clear();
        }
        return li;
    }
}
