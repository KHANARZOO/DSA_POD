class Solution {
    public static String minWindow(String s, String p) {
        int n = s.length();
        int m = p.length();
        int start = -1;
        int minLen = Integer.MAX_VALUE;
        Map<Character, Integer> map = new HashMap<>();
        for(int i=0; i<m; i++)
            map.put(p.charAt(i), map.getOrDefault(p.charAt(i), 0) + 1);
        
        int i =0;
        int j =0;
        int match = 0;
        while( j< n){
            if(map.containsKey(s.charAt(j))){
                map.put(s.charAt(j), map.put(s.charAt(j), 0) - 1);
                if(map.get(s.charAt(j)) >= 0)
                    match +=1;
            }
            while(match == m){
                if(minLen > (j - i + 1)){
                    minLen = j - i + 1;
                    start = i;
                }
                if(map.containsKey(s.charAt(i))){
                    map.put(s.charAt(i), map.put(s.charAt(i), 0) + 1);
                    if(map.get(s.charAt(i)) > 0)
                        match -=1;
                }
                i+=1;
            }
             j+=1;
        }
        if(start != -1) return s.substring(start, start + minLen);
        return "";
    }
}
