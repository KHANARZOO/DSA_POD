class Solution {
    int n;
    int m;
    public int numSpecial(int[][] mat) {
        n = mat.length;
        m = mat[0].length;
        int count = 0;
        int[] row = new int[n];
        int[] col = new int[m];

        for (int i = 0; i < n; i++) {
            for (int j = 0; j < m; j++) {
                if (mat[i][j] == 1) {
                    row[i] += 1;
                    col[j] += 1;
                }
            }
        }
        for (int i = 0; i < n; i++) {
            for (int j = 0; j < m; j++) {
                if(mat[i][j] == 1 && row[i] == 1 && col[j] == 1)
                    count+=1;
            }
        }
        return count;
    }
