class Solution {
    public int sumSubMins(int[] arr) {
        int n = arr.length;
        int min = Integer.MAX_VALUE;
        int sum = 0;
        
        Stack<Integer> st = new Stack<>();
        int[] nSmallerLeft = new int[n];
        int[] nSmallerRight = new int[n];
        
        nSmallerLeft[0] = -1;
        nSmallerRight[n - 1] = n;
        
        st.push(0);
        
        for(int i=1; i<n; i++){
            
            while(!st.isEmpty() && arr[st.peek()] > arr[i]){
                st.pop();
            }
            if(st.isEmpty()) nSmallerLeft[i] = -1;
            else nSmallerLeft[i] = st.peek();
            st.push(i);
        }
        st.clear();
        
        st.push(n - 1);
        for(int i=n-2; i>=0; i--){
            while(!st.isEmpty() && arr[st.peek()] >= arr[i]){
                st.pop();
            }
            if(st.isEmpty()) nSmallerRight[i] = n;
            else nSmallerRight[i] = st.peek();
            st.push(i);
        }
        for(int i=0; i<n; i++){
            
            sum += (i - nSmallerLeft[i]) * (nSmallerRight[i] - i) * arr[i];
        }
        return sum;
    }
}
