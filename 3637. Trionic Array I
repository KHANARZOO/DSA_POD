class Solution {
    public boolean isTrionic(int[] nums) {
        int ans = -1;  // This keeps track of the current phase
        int n = nums.length;

        for (int i = 1; i < n; i++) {
            // Phase 0: Strictly increasing
            if (nums[i] > nums[i - 1] && (ans == -1 || ans == 0)) {
                ans = 0;  // We are in the increasing phase
            }
            // Phase 1: Strictly decreasing
            else if (nums[i] < nums[i - 1] && (ans == 0 || ans == 1)) {
                ans = 1;  // We transitioned to decreasing phase
            }
            // Phase 2: Strictly increasing again
            else if (nums[i] > nums[i - 1] && (ans == 1 || ans == 2)) {
                ans = 2;  // We transitioned to final increasing phase
            }
            // If none of the valid transitions are met, return false
            else {
                return false;  // The pattern is broken
            }
        }

        // To be a trionic sequence, we must have reached phase 2
        return ans == 2;
    }
}
