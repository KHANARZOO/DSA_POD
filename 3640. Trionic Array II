class Solution {
    int n;
    static final long NEG_INF = Long.MIN_VALUE / 2;
    long[][] dp;
    public long maxSumTrionic(int[] nums) {
        n = nums.length;
        dp = new long[n + 1][4];
        for(int i=0; i<n; i++) Arrays.fill(dp[i], Long.MIN_VALUE);
        return solve(0, 0, nums);
    }

    private long solve(int i, int trend, int[] nums) {
        if (i == n) {
            if (trend == 3)
                return 0;
            return NEG_INF;
        }
        if(dp[i][trend] != Long.MIN_VALUE) return dp[i][trend];
        long take = NEG_INF;
        long skip = NEG_INF;

        if (trend == 0)
            skip = solve(i + 1, 0, nums);

        if (trend == 3)
            take = nums[i];

        if (i + 1 < n) {
            int curr = nums[i];
            int next = nums[i + 1];

            if (trend == 0 && next > curr)
                //increasing phase 1 - trend - 1
                take = Math.max(take, curr + solve(i + 1, 1, nums));
            else if (trend == 1) {
                //increasing phase - continue
                if (next > curr)
                    take = Math.max(take, curr + solve(i + 1, 1, nums));
                //decreasing phase - trend - 2
                else if (next < curr)
                    take = Math.max(take, curr + solve(i + 1, 2, nums));
            } else if (trend == 2) {
                //decreasing phase - continue
                if (next < curr)
                    take = Math.max(take, curr + solve(i + 1, 2, nums));
                //increasing phase 2
                else if (next > curr)
                    take = Math.max(take, curr + solve(i + 1, 3, nums));
            } else if (trend == 3) {
                //increasing phase 2
                if (next > curr)
                    take = Math.max(take, curr + solve(i + 1, 3, nums));
            }
        }
        dp[i][trend] = Math.max(take, skip);;
        return dp[i][trend];
    }
}
