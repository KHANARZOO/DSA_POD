class Solution {
    public int minCandy(int arr[]) {
        //Approach 1
        int n = arr.length;
        int[] L2R = new int[n];
        int[] R2L = new int[n];
        
        Arrays.fill(L2R, 1);
        Arrays.fill(R2L, 1);
        
        for(int i=1; i<n; i++){
            if(arr[i] > arr[i - 1]) L2R[i] = L2R[i - 1] + 1;
        }
        for(int i = n-2; i>=0; i--){
            if(arr[i] > arr[i + 1]) R2L[i] = R2L[i + 1] + 1;
        }
        int res = 0;
        for(int i=0; i<n; i++){
            res += Math.max(L2R[i], R2L[i]);
        }
        return res;
    }
}

