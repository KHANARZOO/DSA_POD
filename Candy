class Solution {
    public int minCandy(int arr[]) {
        //Approach 2
        int candy = n;
        int i = 1;
        while(i < n){
            while(i< n && arr[i] == arr[i - 1]){
                i+=1;
            }
            int peak = 0;
            while( i< n && arr[i] > arr[i - 1]) {
                peak += 1;
                candy += peak;
                i+=1;
                if(i == n) return candy;
            }
            int dip = 0;
            while(i < n && arr[i] < arr[i - 1]){
                dip +=1;
                candy += dip;
                i+=1;
            }
            candy -= Math.min(peak, dip);
        }
        return candy;
    }
}
