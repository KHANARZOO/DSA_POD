class Solution {
    public int findKRotation(int nums[]) {
        int n = nums.length;
        int i = 0;
        int j = n - 1;
        int minIndex = 0;
        while (i <= j) {
            int mid = i + (j - i) / 2;
            if (nums[0] <= nums[mid]) {
                //mid is in rotated part
                i = mid + 1;
            } else {
                minIndex = mid;
                j = mid - 1;
            }
        }
        return minIndex;
    }
}
