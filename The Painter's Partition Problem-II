class Solution {
    public int minTime(int[] arr, int k) {
        int n = arr.length;
        int max = 0;
        int sum = 0;
        int res = 0;
        for(int i=0; i<n; i++){
            max = Math.max(max, arr[i]);
            sum += arr[i];
        }
        int low = max;
        int high = sum;
        
        while(low <= high){
            int mid = low + (high - low)/2;
            
            if(isPos(arr, mid, k)){
                res = mid;
                high = mid - 1;
            }else low = mid + 1;
        }
        return res;
    }
    private boolean isPos(int[] arr, int mid, int k){
        int count = 1;
        int sum = 0;
        for(int i=0; i<arr.length; i++){
            if(sum + arr[i] > mid){
                count +=1;
                sum = arr[i];
            }else sum += arr[i];
        }
        if(count > k)return false;
        return true;
    }
}
