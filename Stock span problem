class Solution {
    public ArrayList<Integer> calculateSpan(int[] arr) {
        // code here
        int n = arr.length;
        LinkedList<Integer>stack = new LinkedList<>();
        ArrayList<Integer> li = new ArrayList<>();
        Collections.fill(li,1);
        for(int i=0;i<n;i++){
                while(!stack.isEmpty() && arr[i]>=arr[stack.peek()]){
                    stack.pop();
                }
                if(stack.isEmpty()){
                    li.add(i+1);
                }else{
                    li.add(i-stack.peek());
                }
                stack.push(i);
        }
        return li;
    }
}
