class Solution {
    static int dp[][];
    static int noOfWays(int m, int n, int x) {
        dp = new int[51][51];
        for(int i=0; i<51; i++)
            Arrays.fill(dp[i], -1);
        return solve(m, n, x);
    }
    static int solve(int m, int n, int x){
        if(x < 0) return 0;
        if(dp[n][x] != -1) return dp[n][x];
        if(n == 0){
            if(x == 0) return 1;
            return 0;
        }
        int ways = 0;
        for(int i=1; i<=m; i++)
            ways += solve(m, n - 1, x - i);
        dp[n][x] =  ways;
        return dp[n][x];
    }
};
