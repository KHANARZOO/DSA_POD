class Solution {
    public char nextGreatestLetter(char[] letters, char target) {
        int n = letters.length;
        int targetAscii = target - 'a';
        for (int i = 0; i < n; i++) {
            if ((letters[i] - 'a') > targetAscii) {
                return letters[i];
            }
        }
        return letters[0];
    }
}
