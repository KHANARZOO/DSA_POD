class Solution {
    public int maxProfit(int[] prices) {
        int n = prices.length;
        int buyPrice = prices[0];
        int sellPrice = 0;
        int maxProfit = 0;
        for(int i=1; i<n; i++){
            if(prices[i] < buyPrice) buyPrice = prices[i];
            else if(prices[i] > buyPrice){
                sellPrice = prices[i];
                maxProfit = Math.max(maxProfit, sellPrice - buyPrice);
            }
        }
        return maxProfit;
    }
}
