class Solution {
    public int[] minBitwiseArray(List<Integer> nums) {
        int n = nums.size();
        boolean found = false;
        int[] res = new int[n];
        for(int i=0; i<n; i++){
            found = false;
            for(int j=0; j<nums.get(i); j++){
                if((j | (j + 1)) == nums.get(i)){
                    res[i] = j;
                    found = true;
                    break;
                }
            }
            if(!found) res[i] = -1;
        }
        return res;
    }
}
