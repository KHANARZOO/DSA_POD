class Solution {
    public int minRemoval(int[] nums, int k) {
        int n = nums.length;
        Arrays.sort(nums);
        int i = 0;
        int j = 0;
        int maxLen = 0;

        while (j < n) {
            long min = nums[i];
            long max = nums[j];

            if (max <= (min * k)) {
                maxLen = Math.max(maxLen, j - i + 1);
                j += 1;
            } else
                i += 1;
        }
        return n - maxLen;
    }
}
