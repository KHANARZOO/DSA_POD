class Solution {
    public int sumFourDivisors(int[] nums) {
        int n = nums.length;
        int res = 0;
        for (int i = 0; i < n; i++) {
            res += factor(nums[i]);
        }
        return res;
    }

    public int factor(int num) {
        int count = 0;
        int sum = 0;
        for (int i = 1; i * i <= num; i++) {
            int f1 = num % i;
            if (f1 == 0) {
                int f2 = num/i;
                if (f2 == i)
                    count += 1;
                else
                    count += 2;
                sum += i + f2;
            }
        }
        if (count == 4)
            return sum;
        return 0;
    }
}
