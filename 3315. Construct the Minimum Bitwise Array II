class Solution {
    public int[] minBitwiseArray(List<Integer> nums) {
        int n = nums.size();
        int[] res = new int[n];
        boolean found = false;
        for (int i = 0; i < n; i++) {
            if (nums.get(i) == 2) {
                res[i] = -1;
                continue;
            }
            for (int j = 1; j < 32; j++) {
                if ((nums.get(i) & (1 << j)) > 0)
                    continue;
                else {
                    int prev = j - 1;
                    int curr = (nums.get(i) ^ (1 << prev));
                    res[i] = curr;
                    found = true;
                    break;
                }
            }
            if (!found)
                res[i] = -1;
        }
        return res;
    }
}
