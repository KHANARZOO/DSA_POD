class Solution {
    public int minimumDifference(int[] nums, int k) {
        int n = nums.length;
        Arrays.sort(nums);
        int i = 0;
        int j = k - 1;
        int minDiff = Integer.MAX_VALUE;
        while (j < n) {
            minDiff = Math.min(minDiff, nums[j] - nums[i]);
            i+=1;
            j+=1;
        }
        return minDiff;
    }
}
