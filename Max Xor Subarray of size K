class Solution {
    public int maxSubarrayXOR(int[] arr, int k) {
        //Brute Force Approach
        int n = arr.length;
        int currXor = 0;
        int maxXor = 0;
        // int si = 0;
        // for(int i=0; i<n; i++){
        //     currXor = 0;
        //     for(int j=i; j<n; j++){
        //         currXor ^= arr[j];
        //         if (j - i + 1 == k) {
        //             maxXor = Math.max(maxXor, currXor);
        //             break;
        //         }
        //     }
        // }
        // return maxXor;
        
        //Optimised Approach
        for(int i=0; i<k; i++){
            currXor ^= arr[i];
        }
        maxXor = currXor;
        for(int i=k ;i<n; i++){
            currXor ^= arr[i];   
            currXor ^= arr[i - k]; 
            maxXor = Math.max(maxXor, currXor);
        }
        return maxXor;
    }
}
