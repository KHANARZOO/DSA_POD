class Solution {
    public ArrayList<Integer> maxOfSubarrays(int[] arr, int k) {
        int n = arr.length;
        int max = 0;
        ArrayList<Integer> res = new ArrayList<>();
        Deque<Integer> deque = new ArrayDeque<>();
        
        //First window
        for(int i=0; i<k; i++){
            while(!deque.isEmpty() && arr[deque.peekLast()] <= arr[i]) deque.pollLast();
            deque.offerLast(i);
            if(i >= k- 1) res.add(arr[deque.peekFirst()]);
        }
        
        for(int i=k; i<n; i++){
            if(deque.getFirst() < (i - k + 1)) deque.pollFirst();
            while(!deque.isEmpty() && arr[deque.peekLast()] <= arr[i]) deque.pollLast();
            deque.offerLast(i);
            if(i >= k- 1) res.add(arr[deque.peekFirst()]);
        }
        return res;
    }
}
