class Solution {
    public int countAtMostK(int arr[], int k) {
        int n = arr.length;
        //Brute Force Approach
        int count = 0;
        HashSet<Integer> set = new HashSet<>();
        
        for(int i=0; i<n; i++){
            for(int j=i; j<n; j++){
                set.add(arr[j]);
                if(set.size() <= k) count += 1;
                else break;
            }
            set.clear();
        }
        return count;
    }
}
