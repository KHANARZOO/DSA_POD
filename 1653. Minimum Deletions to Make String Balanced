class Solution {
    public int minimumDeletions(String s) {
        int n = s.length();
        Stack<Character> st = new Stack<>();
        int count = 0;
        st.add(s.charAt(0));
        for (int i = 1; i < n; i++) {
            char ch = s.charAt(i);
            if (!st.isEmpty() && ch == 'a' && st.peek() == 'b') {
                count += 1;
                st.pop();
            } else
                st.add(ch);
        }
        return count;
    }
}
