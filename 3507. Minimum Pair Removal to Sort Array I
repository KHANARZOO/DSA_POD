class Solution {
    private int minPairSum(List<Integer> li) {
        int minSum = Integer.MAX_VALUE;
        int idx = -1;

        for (int i = 0; i < li.size() - 1; i++) {
            if ((li.get(i) + li.get(i + 1)) < minSum) {
                minSum = li.get(i) + li.get(i + 1);
                idx = i;
            }
        }
        return idx;
    }

    public int minimumPairRemoval(int[] nums) {
        int n = nums.length;
        int res = 0;
        List<Integer> li = new ArrayList<>();
        for (int i : nums)
            li.add(i);

        List<Integer> copyli = new ArrayList<>(li);
        Collections.sort(copyli);

        while (!li.equals(copyli)) {
            int idx = minPairSum(li);
            if (idx == -1)
                break;
            li.set(idx, (li.get(idx) + li.get(idx + 1)));
            li.remove(idx + 1);
            res += 1;
            copyli = new ArrayList<>(li);
            Collections.sort(copyli);
        }
        return res;
    }
}
