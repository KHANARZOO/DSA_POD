class kQueues {
    List<Integer>[] queue;
    int n;
    int k;
    int currSize;
    kQueues(int n, int k) {
        // Initialize your data members
        @SuppressWarnings("unchecked")
        List<Integer>[] t = new ArrayList[k];
        queue = t;
        for(int i=0; i<k; i++){
            queue[i] = new ArrayList<>();
        }
        this.n = n;
        this.k = k;
        currSize = 0;
    }

    void enqueue(int x, int i) {
        // enqueue element x into queue number i
        if(currSize == n) return;
        
        queue[i].add(x);
        currSize+=1;
    }

    int dequeue(int i) {
        // dequeue element from queue number i
        if(queue[i].size() != 0){
            int deq = queue[i].get(0);
            queue[i].remove(0);
            currSize-=1;
            return deq;
        }
        return -1;
    }

    boolean isEmpty(int i) {
        // check if queue i is empty
        if(queue[i].size() == 0) return true;
        return false;
    }

    boolean isFull() {
        // check if array is full
        if(n == currSize) return true;
        return false;
    }
}
