class Solution {
    List<Integer> li;

    public TreeNode balanceBST(TreeNode root) {
        li = new ArrayList<>();
        inorder(root);
        return solve(0, li.size() - 1);
    }

    private void inorder(TreeNode root) {
        if (root == null)
            return;
        inorder(root.left);
        li.add(root.val);
        inorder(root.right);
    }

    private TreeNode solve(int l, int r) {
        if (l > r)
            return null;
        int mid = l + (r - l) / 2;
        TreeNode node = new TreeNode(li.get(mid));
        node.left = solve(l, mid - 1);
        node.right = solve(mid + 1, r);
        return node;
    }
}
