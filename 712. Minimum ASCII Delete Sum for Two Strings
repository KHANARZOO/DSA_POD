class Solution {
    int n;
    int m;
    int[][] dp;

    public int minimumDeleteSum(String s1, String s2) {
        n = s1.length();
        m = s2.length();
        dp = new int[n + 1][m + 1];
        for (int i = 0; i <= n; i++) {
            Arrays.fill(dp[i], -1);
        }
        return solve(s1, s2, 0, 0);
    }

    private int solve(String s1, String s2, int i, int j) {
        if (i >= n && j >= m)
            return 0;
        if (dp[i][j] != -1)
            return dp[i][j];
        if (i >= n)
            return dp[i][j] = (int) s2.charAt(j) + solve(s1, s2, i, j + 1);
        if (j >= m)
            return dp[i][j] = (int) s1.charAt(i) + solve(s1, s2, i + 1, j);
        if (s1.charAt(i) == s2.charAt(j))
            return dp[i][j] = solve(s1, s2, i + 1, j + 1);

        int op1 = (int) s1.charAt(i) + solve(s1, s2, i + 1, j);
        int op2 = (int) s2.charAt(j) + solve(s1, s2, i, j + 1);

        return dp[i][j] = Math.min(op1, op2);
    }
}
