class Solution {
    public int minFlips(String s) {
        int n = s.length();
        String str = s + s;
        StringBuilder s1 = new StringBuilder(); //1010 
        StringBuilder s2 = new StringBuilder(); //0101

        for (int i = 0; i < 2 * n; i++) {
            if (i % 2 == 0) {
                s1.append(1);
                s2.append(0);
            } else {
                s1.append(0);
                s2.append(1);
            }
        }

        int i = 0;
        int j = 0;
        int res = Integer.MAX_VALUE;
        int f1 = 0;
        int f2 = 0;

        while (j < 2 * n) {
            if (str.charAt(j) != s1.charAt(j))
                f1 += 1;
            if (str.charAt(j) != s2.charAt(j))
                f2 += 1;

            if ((j - i + 1) > n) {
                if (str.charAt(i) != s1.charAt(i))
                    f1 -= 1;
                if (str.charAt(i) != s2.charAt(i))
                    f2 -= 1;
                i += 1;
            }
            if ((j - i + 1) == n)
                res = Math.min(res, Math.min(f1, f2));
            j += 1;
        }
        return res;
    }
}
/*
1010 -> even idx - 1 and odd idx - 0
0101 -> even idx - 0 and odd idx - 1

*/
