class Solution {
    public int maxSubarraySum(int[] arr, int k) {
        int n = arr.length;
        int sum = 0;
        int maxSum = 0;
        
        for(int i=0; i<k; i++){
            sum+= arr[i];
        }
        maxSum = Math.max(maxSum, sum);
        int st = 1;
        int ed = k;
        
        while(ed < n){
            sum -= arr[st - 1];
            sum += arr[ed];
            maxSum = Math.max(maxSum, sum);
            st++;
            ed++;
        }
        return maxSum;
    }
}
